---
interface Props {
  page: 'home' | 'bracket' | 'map' | 'match' | 'auth';
}
const { page } = Astro.props;

const nav = [
  { key: 'home',    href: '/',        label: 'Home',    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 11 12 4l8 7"/><path d="M6 10v9h12v-9"/></svg>` },
  { key: 'bracket', href: '/bracket', label: 'Bracket', icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 5h6M3 5v6M9 8h4M13 8v8M13 16H9M3 19h6M3 13v6M17 12h4"/></svg>` },
  { key: 'map',     href: '/map',     label: 'Map',     icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M3 12h18"/><path d="M12 3a14 14 0 0 1 0 18a14 14 0 0 1 0-18"/></svg>` },
  { key: 'match',   href: '/match',   label: 'Scores',  icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7l3 2.2-1.1 3.5h-3.8L9 9.2 12 7z"/></svg>` },
];

const titles: Record<string, string> = {
  home: 'Mission Control',
  bracket: 'Tournament Bracket',
  map: 'Nations',
  match: 'Match Centre',
  auth: 'Your Teams',
};
---

<div class="app-shell" style="display:flex;min-height:100vh;background:#070a0f;background-image:radial-gradient(1100px 620px at 78% -8%,var(--kit-soft),transparent 60%),radial-gradient(900px 520px at 8% 108%,rgba(255,255,255,.025),transparent 55%);color:#e9edf2">

  <!-- SIDEBAR -->
  <aside style="width:76px;flex:none;border-right:1px solid rgba(255,255,255,.07);display:flex;flex-direction:column;align-items:center;padding:18px 0;gap:6px;position:sticky;top:0;height:100vh;background:rgba(8,11,16,.72);backdrop-filter:blur(8px);z-index:5">
    <a href="/" style="display:block;width:40px;height:40px;border-radius:11px;background:var(--kit);color:var(--kit-contrast);display:grid;place-items:center;font:700 22px/1 'Barlow Condensed',sans-serif;margin-bottom:14px;box-shadow:0 0 22px -4px var(--kit-glow);text-decoration:none">P</a>

    {nav.map(n => (
      <a
        href={n.href}
        title={n.label}
        style={`display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;width:52px;height:52px;border-radius:13px;text-decoration:none;transition:all .16s;background:${page===n.key?'var(--kit-soft)':'transparent'};color:${page===n.key?'var(--kit)':'#7c8a9c'}`}
      >
        <span set:html={n.icon} style="display:grid;place-items:center" />
        <span style="font:600 8.5px/1 'Hanken Grotesk';letter-spacing:.4px;text-transform:uppercase">{n.label}</span>
      </a>
    ))}

    <div style="flex:1" />

    <a href="/auth" style="width:44px;height:44px;border-radius:50%;border:2px solid var(--kit);background:var(--kit-soft);color:var(--kit);display:grid;place-items:center;font:700 16px/1 'Barlow Condensed',sans-serif;text-decoration:none" title="Account">P</a>
  </aside>

  <!-- MAIN -->
  <div style="flex:1;min-width:0;display:flex;flex-direction:column">

    <!-- HEADER -->
    <header style="height:64px;flex:none;border-bottom:1px solid rgba(255,255,255,.07);display:flex;align-items:center;gap:18px;padding:0 26px;position:sticky;top:0;background:rgba(8,11,16,.82);backdrop-filter:blur(10px);z-index:4">
      <div style="display:flex;flex-direction:column;gap:1px;min-width:0">
        <span style="font:600 9px/1 'JetBrains Mono',monospace;letter-spacing:2px;color:#5e6b7d;text-transform:uppercase">FIFA WORLD CUP 26</span>
        <span style="font:600 22px/1 'Barlow Condensed',sans-serif;letter-spacing:.4px;text-transform:uppercase">{titles[page] ?? 'Pitch'}</span>
      </div>
      <div style="flex:1" />
      <!-- Live badge island -->
      <div id="live-badge-slot" />
      <!-- Kit theme header island -->
      <div id="kit-header-slot" />
    </header>

    <!-- PAGE CONTENT -->
    <main style="flex:1;min-width:0;overflow:auto">
      <slot />
    </main>
  </div>
</div>
